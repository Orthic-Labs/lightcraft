{
  "type": "object",
  "additionalProperties": false,
  "required": ["proxyQuality", "sharpness", "blink", "calibration", "acceptableWinnerIds", "items"],
  "properties": {
    "proxyQuality": {"type": "string", "enum": ["limited512"]},
    "sharpness": {"type": "string", "enum": ["unavailable"]},
    "blink": {"type": "string", "enum": ["unavailable"]},
    "calibration": {"type": "string", "enum": ["unknown"]},
    "acceptableWinnerIds": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "items": {
      "type": "array", "minItems": 2, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "decision", "reasonCodes", "reason", "uncertainty", "confidence", "confidenceKind"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "decision": {"type": "string", "enum": ["reject", "keep", "pick", "review", "abstain"]},
          "reasonCodes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "enum": ["relativeContent", "timeSimilarity", "ambiguousQuality", "insufficientProxy", "tieForBest", "modelUncertain", "abstained"]}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 240},
          "uncertainty": {"type": "string", "enum": ["unknown", "elevated", "high"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "confidenceKind": {"type": "string", "enum": ["unqualified"]}
        }
      }
    }
  }
}
