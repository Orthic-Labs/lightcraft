<?xml version="1.0" encoding="utf-8"?>
<!--
  Ember MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build lightcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files with an Ember Start Menu shortcut.
  Executable is installed as Ember.exe so App Paths registration is distinct from LightCraft.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Ember"
      Manufacturer="Orthic Labs"
      Version="$(var.Version)"
      UpgradeCode="E4A97884-9B82-48C1-AD9D-0D8C561EAF37"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Ember photo library and raw developer" Manufacturer="Orthic Labs" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Ember is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LightcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LightcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Orthic-Labs/lightcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Orthic-Labs/lightcraft" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Orthic-Labs/lightcraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Ember" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Ember" Level="1">
      <ComponentGroupRef Id="LightcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="LightcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="LightcraftApp" Guid="19AB9E2D-65A1-4C20-96C6-701BF5F7FDE7">
        <File Id="LightcraftExe" Name="Ember.exe" Source="$(var.BinDir)\lightcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Ember"
              Description="Ember photo library and raw developer" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LightcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\Ember.exe" Value="[#LightcraftExe]" Type="string" />
      </Component>

      <Component Id="LightcraftCli">
        <File Id="LightcraftCliExe" Source="$(var.BinDir)\lightcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
